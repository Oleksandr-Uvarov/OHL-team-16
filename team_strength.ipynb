    "import pandas as pd\n",
    "import numpy as np\n",
    "import statsmodels.api as sm\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.metrics import mean_absolute_error, mean_squared_error\n",
    "\n",
    "# --- 1. LOAD EXTERNAL CHAMPIONSHIP DATA ---\n",
    "# Data extracted from your screenshot, names mapped to match your database\n",
    "champ_data = {\n",
    "    'Team': [\n",
    "        'Club Brugge', 'Anderlecht', 'Genk', 'Standard Liège', 'Gent',\n",
    "        'Union Saint-Gilloise', 'Antwerp', 'Zulte Waregem', 'Sporting Charleroi',\n",
    "        'Kortrijk', 'Oostende', 'Lokeren', 'Cercle Brugge', 'Sint-Truiden'\n",
    "    ],\n",
    "    'Champ_Points': [240, 201, 160, 114, 107, 55, 49, 47, 29, 29, 23, 19, 13, 13]\n",
    "}\n",
    "df_champ = pd.DataFrame(champ_data)\n",
    "\n",
    "# --- 2. LOAD MATCH DATA ---\n",
    "matches = pd.read_csv(\"data/gold_match.csv\")\n",
    "\n",
    "# Filter for OHL home games with historical attendance data\n",
    "ohl_home = matches[(matches['is_home_match'] == True) & (matches['tickets_scanned'].notna())].copy()\n",
    "\n",
    "# --- 3. MERGE DATA ---\n",
    "# Left merge to keep all OHL home games\n",
    "df_reg = pd.merge(ohl_home[['match_id', 'away_team', 'tickets_scanned']], \n",
    "                  df_champ, \n",
    "                  left_on='away_team', \n",
    "                  right_on='Team', \n",
    "                  how='left')\n",
    "\n",
    "# Teams not in the Championship table get 0 points (e.g., Mechelen, Westerlo)\n",
    "df_reg['Champ_Points'] = df_reg['Champ_Points'].fillna(0)\n",
    "\n",
    "# --- 4. LINEAR REGRESSION ---\n",
    "X = df_reg['Champ_Points']\n",
    "y = df_reg['tickets_scanned']\n",
    "\n",
    "# Add constant (intercept) for statsmodels\n",
    "X_with_const = sm.add_constant(X)\n",
    "\n",
    "# Fit the OLS Model\n",
    "model = sm.OLS(y, X_with_const).fit()\n",
    "predictions = model.predict(X_with_const)\n",
    "\n",
    "# --- 5. CALCULATE EVALUATION METRICS ---\n",
    "mae = mean_absolute_error(y, predictions)\n",
    "rmse = np.sqrt(mean_squared_error(y, predictions))\n",
    "r2 = model.rsquared\n",
    "correlation = df_reg['Champ_Points'].corr(df_reg['tickets_scanned'])\n",
    "\n",
    "print(\"=== REGRESSION RESULTS (CHAMPIONSHIP POINTS) ===\")\n",
    "print(f\"R-squared:    {r2:.4f} (Explains {r2*100:.1f}% of attendance variance)\")\n",
    "print(f\"Correlation:  {correlation:.4f}\")\n",
    "print(f\"MAE:          {mae:.0f} spectators\")\n",
    "print(f\"RMSE:         {rmse:.0f}\")\n",
    "print(\"-\" * 46)\n",
    "print(model.summary())\n",
    "\n",
    "# --- 6. VISUALIZATION ---\n",
    "plt.figure(figsize=(12, 8))\n",
    "\n",
    "# Scatter plot\n",
    "plt.scatter(df_reg['Champ_Points'], df_reg['tickets_scanned'], \n",
    "            alpha=0.6, c='purple', edgecolors='k', s=70, label='Matches')\n",
    "\n",
    "# Regression Line\n",
    "x_range = np.linspace(X.min(), X.max(), 100)\n",
    "y_line = model.params['const'] + model.params['Champ_Points'] * x_range\n",
    "plt.plot(x_range, y_line, color='orange', linewidth=3, label=f'Linear Fit (R²={r2:.2f})')\n",
    "\n",
    "# Annotate the teams (using a set to avoid labeling the same team 5 times)\n",
    "labeled_teams = set()\n",
    "for i, row in df_reg.iterrows():\n",
    "    team = row['away_team']\n",
    "    if team not in labeled_teams:\n",
    "        # Move the text slightly so it doesn't overlap exactly with the dots\n",
    "        plt.annotate(team, (row['Champ_Points'], row['tickets_scanned']), \n",
    "                     xytext=(6, 2), textcoords='offset points', fontsize=9, alpha=0.8)\n",
    "        labeled_teams.add(team)\n",
    "\n",
    "plt.title('Prediction Model: Tickets Scanned vs. All-Time Championship Points', fontsize=15)\n",
    "plt.xlabel('Opponent Historical Championship Points (0 = Not in Top 14)', fontsize=12)\n",
    "plt.ylabel('Tickets Scanned (Attendance)', fontsize=12)\n",
    "plt.grid(True, linestyle='--', alpha=0.4)\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
