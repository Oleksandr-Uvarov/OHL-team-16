   "source": [
    "import pandas as pd\n",
    "\n",
    "# --- 1. DEFINE WIKIPEDIA DATA (From Screenshot) ---\n",
    "# I have added name mapping to ensure \"Union SG\" matches \"Union Saint-Gilloise\" etc.\n",
    "wiki_strength = {\n",
    "    'Club Brugge': 240,\n",
    "    'Anderlecht': 201,\n",
    "    'Genk': 160,\n",
    "    'Standard Liège': 114,\n",
    "    'Gent': 107,\n",
    "    'Union Saint-Gilloise': 55,  # Mapped from \"Union SG\"\n",
    "    'Antwerp': 49,\n",
    "    'Zulte Waregem': 47,\n",
    "    'Sporting Charleroi': 29,\n",
    "    'Kortrijk': 29,\n",
    "    'Oostende': 23,\n",
    "    'Lokeren': 19,\n",
    "    'Cercle Brugge': 13,\n",
    "    'Sint-Truiden': 13\n",
    "}\n",
    "\n",
    "# --- 2. GET ALL TEAMS FROM YOUR DATABASE ---\n",
    "matches = pd.read_csv(\"data/gold_match.csv\")\n",
    "\n",
    "# Combine home and away teams to get every single club OHL has played against\n",
    "all_unique_teams = pd.concat([matches['home_team'], matches['away_team']]).unique()\n",
    "\n",
    "# --- 3. CREATE THE STRENGTH TABLE ---\n",
    "# Create a DataFrame from your database team list\n",
    "team_strength_df = pd.DataFrame(all_unique_teams, columns=['team'])\n",
    "\n",
    "# Map the points from the dictionary (if not found, result is NaN)\n",
    "team_strength_df['team_strength'] = team_strength_df['team'].map(wiki_strength)\n",
    "\n",
    "# Replace NaN with 0 for teams not in the Wikipedia list (e.g., Westerlo, Mechelen)\n",
    "team_strength_df['team_strength'] = team_strength_df['team_strength'].fillna(0).astype(int)\n",
    "\n",
    "# --- 4. FORMAT AND SORT ---\n",
    "# Sorting by strength (highest first) then alphabetically for the 0-point teams\n",
    "team_strength_df = team_strength_df.sort_values(by=['team_strength', 'team'], ascending=[False, True])\n",
    "\n",
    "# Optional: Add a 'Category' column for your final report (Section 3.3 in your brief)\n",
    "def categorize(pts):\n",
    "    if pts > 150: return 'Elite'\n",
    "    if pts > 40:  return 'Good'\n",
    "    if pts > 0:   return 'Mid'\n",
    "    return 'Bad'\n",
    "\n",
    "team_strength_df['category'] = team_strength_df['team_strength'].apply(categorize)\n",
    "\n",
    "# --- 5. DISPLAY RESULTS ---\n",
    "print(\"=== FINAL TEAM STRENGTH LOOKUP TABLE ===\")\n",
    "print(team_strength_df.to_string(index=False))\n",
    "\n",
    "# Optional: Save to CSV for use in your other notebooks\n",
    "team_strength_df.to_csv(\"analysis/team_strength_lookup.csv\", index=False)"
   ]
  }
