   "source": [
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "\n",
    "# 1. Garantir que a coluna 'match_date' está no formato de data (datetime)\n",
    "match_tickets['match_date'] = pd.to_datetime(match_tickets['match_date'])\n",
    "\n",
    "# 2. Criar uma nova coluna para o mês\n",
    "# .dt.month extrai o número do mês (1 a 12). \n",
    "# Se preferires o nome do mês, podes usar: .dt.month_name()\n",
    "match_tickets['match_month'] = match_tickets['match_date'].dt.month\n",
    "\n",
    "# 3. Agrupar os dados por mês e somar as faltas\n",
    "faltas_por_mes = match_tickets.groupby('match_month')['dif_scanned_sum'].sum().reset_index()\n",
    "\n",
    "# Opcional: Para os meses aparecerem com o nome em vez de números no gráfico (ex: Jan, Fev, etc.)\n",
    "meses_nomes = {1: 'Jan', 2: 'Fev', 3: 'Mar', 4: 'Abr', 5: 'Mai', 6: 'Jun', \n",
    "               7: 'Jul', 8: 'Ago', 9: 'Set', 10: 'Out', 11: 'Nov', 12: 'Dez'}\n",
    "faltas_por_mes['nome_mes'] = faltas_por_mes['match_month'].map(meses_nomes)\n",
    "\n",
    "# 4. Criar o Gráfico de Barras\n",
    "plt.figure(figsize=(10, 6))\n",
    "\n",
    "# Criar as barras\n",
    "plt.bar(faltas_por_mes['nome_mes'], faltas_por_mes['dif_scanned_sum'], color='coral', edgecolor='black')\n",
    "\n",
    "# Adicionar títulos e rótulos para ser fácil de ler\n",
    "plt.title('No-Shows', fontsize=14, fontweight='bold')\n",
    "plt.ylabel('Number of No-Shows', fontsize=12)\n",
    "\n",
    "# Adicionar uma grelha horizontal para facilitar a leitura dos valores\n",
    "plt.grid(axis='y', linestyle='--', alpha=0.7)\n",
    "\n",
    "# Mostrar o gráfico\n",
    "plt.show()"
   ]
  }
